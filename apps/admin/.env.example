# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# This admin app's own URL (used in password-reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Public website URL + shared secret, used to refresh the site cache after edits (e.g. offers)
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-to-a-long-random-string



# Only source code, configs, migrations and public assets are committed.
# Everything generated, local or secret is ignored below.

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output & caches ───────────────────────────────────
.next/
out/
build/
dist/
.turbo/
.vercel/
.cache/
.eslintcache
.swc/
*.tsbuildinfo
next-env.d.ts

# ── Testing ─────────────────────────────────────────────────
coverage/
playwright-report/
test-results/

# ── Environment / secrets ───────────────────────────────────
# Real keys live in .env.local (never committed). Keep only the templates.
.env
.env.*
!.env.example
*.pem
*.key

# ── Supabase CLI local state ────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS files ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors / IDEs / local tooling ──────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# ── Local notes ─────────────────────────────────────────────
MONOREPO.md

# ── Auto-generated agent notes (re-created by `next dev`) ────
AGENTS.md
CLAUDE.md

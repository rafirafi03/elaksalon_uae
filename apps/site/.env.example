# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# This website's URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email (Resend) — server-only, never NEXT_PUBLIC_
RESEND_API_KEY=re_your_api_key
# Inbox that receives contact form messages (defaults to the company email from admin)
CONTACT_TO_EMAIL=you@example.com
# Sender; must be on a domain verified in Resend (defaults to onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL="Your Salon <contact@yourdomain.com>"

# Shared secret so the admin can refresh cached site data (must match admin REVALIDATE_SECRET)
REVALIDATE_SECRET=change-me-to-a-long-random-string
